+    // True when the sprite piece shows the same picture in both frames (same tile number
+    // and the same tile data in video memory: some games stream each pose into fixed tiles).
+    static bool same_gfx(const Snap& a, const Snap& b, uint16_t pa2, uint16_t a2, int w, int h, bool c256) {
+        if ((pa2 & 0x3FF) != (a2 & 0x3FF)) return false;
+        const bool one_d = (b.dispcnt & 0x40) != 0;
+        const int tb = c256 ? 64 : 32, tw = w / 8, th = h / 8, base = a2 & 0x3FF;
+        for (int ty = 0; ty < th; ++ty) {
+            const int t = one_d ? base + ty * tw * (c256 ? 2 : 1) : base + ty * 32;
+            const std::size_t off = 0x10000 + static_cast<std::size_t>(t & 0x3FF) * 32, n = static_cast<std::size_t>(tw) * tb;
+            if (off + n > a.vram.size() || off + n > b.vram.size()) return true;
+            if (std::memcmp(&a.vram[off], &b.vram[off], n) != 0) return false;
+        }
+        return true;
+    }
