index 0000000..3b7245d
--- /dev/null
+++ b/src/runtime/frame_smooth.h
@@ -0,0 +1,367 @@
+#pragma once
+// 60 fps smoothing for games that draw a new picture every other VBlank.
+//
+// The game's own logic still runs at its normal rate. When a new picture
+// arrives, the host first shows an in-between picture rendered from the new
+// frame's video memory with every background scroll and every matched sprite
+// moved halfway back toward the previous picture; the next VBlank (where the
+// game would have repeated the picture) shows the new frame itself. This adds
+// one VBlank (~16.7 ms) of display delay and never touches emulated state.
+//
+// Safety: the in-between picture is only drawn when re-rendering the new
+// frame from the snapshot reproduces the real picture exactly (no mid-frame
+// raster effects), the display setup is unchanged and the camera moved a
+// small distance. Otherwise the real frame is shown untouched.
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+#include "gba_ppu.h"
+
+namespace gbarecomp {
+
+class FrameSmoother {
+public:
+    struct Snap {
+        std::vector<uint8_t> io, vram, oam, pal;
+        uint16_t dispcnt = 0;
+        bool valid = false;
+        void take(uint16_t d, const uint8_t* i, const uint8_t* v, std::size_t vn,
+                  const uint8_t* o, const uint8_t* p) {
+            io.assign(i, i + 0x400);
+            vram.assign(v, v + vn);
+            oam.assign(o, o + 0x400);
+            pal.assign(p, p + 0x400);
+            dispcnt = d;
+            valid = true;
+        }
+    };
+
+    bool enabled = true;
+    int check_every = 1;
+    uint64_t mids = 0, skipped = 0, blends = 0;
+    bool blend_ = true;
+
+    // Called right after a frame is latched (emulation thread).
+    void on_latch(uint16_t dispcnt, const uint8_t* io, const uint8_t* vram,
+                  std::size_t vram_size, const uint8_t* oam, const uint8_t* pal) {
+        if (!enabled) return;
+        latest_.take(dispcnt, io, vram, vram_size, oam, pal);
+        fresh_ = true;
+    }
+
+    void reset() { prev_.valid = false; fresh_ = false; last_fb_.clear(); }
+
+    // fb holds the latched (real) frame about to be shown. May replace it with
+    // an in-between picture. Returns true if it did.
+    bool apply(const gba::GbaPpu& ppu, uint8_t* fb, std::size_t bytes) {
+        if (!enabled || !fresh_ || !latest_.valid) return false;
+        fresh_ = false;
+        if (bytes != last_bytes_) {  // view size changed
+            prev_.valid = false;
+            last_fb_.clear();
+            last_bytes_ = bytes;
+        }
+        const bool repeat = last_fb_.size() == bytes &&
+                            std::memcmp(last_fb_.data(), fb, bytes) == 0;
+        if (repeat) return false;  // shows the real (already delayed) frame
+        last_fb_.assign(fb, fb + bytes);
+        Snap& b = latest_;
+        bool did = false;
+        if (prev_.valid && compatible(prev_, b)) {
+            // Re-rendering to prove there are no raster effects costs a whole
+            // picture. Where that is too expensive (browser build) only every
+            // check_every-th picture is verified; a failed check forces the
+            // next pictures to be verified again.
+            bool same = true;
+            if (check_every <= 1 || last_check_failed_ || ++unchecked_ >= check_every) {
+                unchecked_ = 0;
+                check_.resize(bytes);
+                ppu.render(check_.data(), b.dispcnt, b.io.data(), b.vram.data(),
+                           b.oam.data(), b.pal.data());
+                same = std::memcmp(check_.data(), fb, bytes) == 0;
+                last_check_failed_ = !same;
+            }
+            if (same) {
+                // An odd step cannot be halved in whole pixels: the picture is
+                // drawn once with each half rounded down and once rounded up and
+                // the two are averaged, so every 60 fps step is the same size
+                // (a 3-pixel move shows as 1.5 + 1.5 instead of 1 + 2).
+                odd_ = false;
+                for (int bg = 0; bg < 4; ++bg) {
+                    cd_[bg][0] = cd_[bg][1] = 0;
+                    if (!(b.dispcnt & (0x100 << bg))) continue;
+                    if ((r16(prev_.io, 0x10 + bg * 4) & 511) < 8 && (r16(b.io, 0x10 + bg * 4) & 511) < 8 &&
+                        (r16(prev_.io, 0x12 + bg * 4) & 511) < 8 && (r16(b.io, 0x12 + bg * 4) & 511) < 8)
+                        coarse_step(prev_, b, bg, cd_[bg][0], cd_[bg][1]);
+                }
+                render_mid(ppu, fb, b, 0);
+                if (odd_ && blend_) {
+                    alt_.resize(bytes);
+                    render_mid(ppu, alt_.data(), b, 1);
+                    for (std::size_t i = 0; i < bytes; ++i)
+                        fb[i] = static_cast<uint8_t>((fb[i] + alt_[i] + 1) >> 1);
+                    ++blends;
+                }
+                did = true;
+                ++mids;
+            } else {
+                ++skipped;
+            }
+        }
+        std::swap(prev_, latest_);
+        latest_.valid = false;
+        return did;
+    }
+
+private:
+    Snap latest_, prev_;
+    bool fresh_ = false;
+    bool last_check_failed_ = true;
+    int unchecked_ = 0;
+    std::vector<uint8_t> last_fb_, check_, io_mid_, oam_mid_, vram_mid_, alt_;
+    bool odd_ = false;
+    int up_ = 0;            // 0: halves rounded toward zero, 1: away from zero
+    int cd_[4][2] = {};     // camera step of each coarse layer (from its map)
+
+    // Half of d, rounded toward zero (up_ == 0) or away from zero (up_ == 1).
+    int half(int d) {
+        if (d & 1) odd_ = true;
+        const int h = d / 2;
+        return up_ ? d - h : h;
+    }
+
+    void render_mid(const gba::GbaPpu& ppu, uint8_t* out, const Snap& b, int up) {
+        up_ = up;
+        io_mid_ = b.io;
+        oam_mid_ = b.oam;
+        vram_mid_ = b.vram;
+        mid_scroll(prev_, b);
+        mid_sprites(prev_, b);
+        for (int bg = 0; bg < 4; ++bg) {
+            gba::g_ws_margin_scroll_override[bg][0] = margin_[bg][0];
+            gba::g_ws_margin_scroll_override[bg][1] = margin_[bg][1];
+        }
+        gba::g_ws_margin_scroll_override_on = 1;
+        ppu.render(out, b.dispcnt, io_mid_.data(), vram_mid_.data(),
+                   oam_mid_.data(), b.pal.data());
+        gba::g_ws_margin_scroll_override_on = 0;
+    }
+    std::size_t last_bytes_ = 0;
+    int margin_[4][2] = {};
+
+    static uint16_t r16(const std::vector<uint8_t>& v, std::size_t o) {
+        return static_cast<uint16_t>(v[o] | (v[o + 1] << 8));
+    }
+    static void w16(std::vector<uint8_t>& v, std::size_t o, uint16_t x) {
+        v[o] = static_cast<uint8_t>(x);
+        v[o + 1] = static_cast<uint8_t>(x >> 8);
+    }
+    // Signed difference a-b on a ring of `mod` values.
+    static int wrap_delta(int a, int b, int mod) {
+        int d = (a - b) % mod;
+        if (d < -mod / 2) d += mod;
+        if (d >= mod / 2) d -= mod;
+        return d;
+    }
+
+    static bool compatible(const Snap& a, const Snap& b) {
+        if (a.dispcnt != b.dispcnt) return false;
+        if ((b.dispcnt & 7) != 0) return false;  // text-mode backgrounds only
+        // BG control, window, blend and brightness setup must be unchanged.
+        if (std::memcmp(&a.io[0x08], &b.io[0x08], 8) != 0) return false;
+        if (std::memcmp(&a.io[0x40], &b.io[0x40], 0x16) != 0) return false;
+        for (int bg = 0; bg < 4; ++bg) {
+            if (!(b.dispcnt & (0x100 << bg))) continue;
+            bool c1, c2;
+            const int dx = axis_delta(r16(a.io, 0x10 + bg * 4) & 511, r16(b.io, 0x10 + bg * 4) & 511, c1);
+            const int dy = axis_delta(r16(a.io, 0x12 + bg * 4) & 511, r16(b.io, 0x12 + bg * 4) & 511, c2);
+            if (std::abs(dx) > 24 || std::abs(dy) > 24) return false;
+        }
+        return true;
+    }
+
+    // True camera move a->b on one axis of one layer, as (scroll_a - scroll_b).
+    // This game scrolls its world layers coarsely by redrawing the whole map one
+    // tile over and keeps the fine scroll in 0..7, so there the smallest move
+    // that matches modulo 8 is the real one.
+    static int axis_delta(int sa, int sb, bool& coarse) {
+        coarse = sa < 8 && sb < 8;
+        if (!coarse) return wrap_delta(sa, sb, 512);
+        int d = sa - sb;           // -7..7
+        if (d > 4) d -= 8; else if (d < -4) d += 8;
+        return d;
+    }
+
+    static uint16_t map_at(const Snap& s, int bg, int x, int y) {
+        const uint16_t cnt = r16(s.io, 0x08 + bg * 2);
+        std::size_t o = static_cast<std::size_t>((cnt >> 8) & 31) * 0x800;
+        const int size = cnt >> 14;
+        x &= 63; y &= 63;
+        if (size == 0 || size == 2) x &= 31;
+        if (size == 0 || size == 1) y &= 31;
+        if (x >= 32) { o += 0x800; x -= 32; }
+        if (y >= 32) { o += (size == 3) ? 0x1000 : 0x800; y -= 32; }
+        o += static_cast<std::size_t>(y * 32 + x) * 2;
+        if (o + 1 >= s.vram.size()) return 0;
+        return static_cast<uint16_t>(s.vram[o] | (s.vram[o + 1] << 8));
+    }
+
+    // Camera step of a coarsely scrolled layer. The fine scroll alone is
+    // ambiguous by a whole tile (a 4-pixel move left and right look the same),
+    // so the map itself says whether the game redrew it one tile over: the
+    // shift that best lines up the new map with the old one is the real one.
+    static void coarse_step(const Snap& a, const Snap& b, int bg, int& dx, int& dy) {
+        const int sax = r16(a.io, 0x10 + bg * 4) & 511, sbx = r16(b.io, 0x10 + bg * 4) & 511;
+        const int say = r16(a.io, 0x12 + bg * 4) & 511, sby = r16(b.io, 0x12 + bg * 4) & 511;
+        int best = -1, bkx = 0, bky = 0, bcost = 1 << 30;
+        for (int ky = -1; ky <= 1; ++ky)
+            for (int kx = -1; kx <= 1; ++kx) {
+                int same = 0;
+                for (int y = 1; y < 20; ++y)
+                    for (int x = 1; x < 30; ++x)
+                        if (map_at(b, bg, x, y) == map_at(a, bg, x + kx, y + ky)) ++same;
+                const int ddx = sax - sbx - 8 * kx, ddy = say - sby - 8 * ky;
+                const int cost = std::abs(ddx) + std::abs(ddy);
+                if (same > best || (same == best && cost < bcost)) { best = same; bkx = kx; bky = ky; bcost = cost; }
+            }
+        dx = sax - sbx - 8 * bkx;
+        dy = say - sby - 8 * bky;
+    }
+
+    int cam_dx_ = 0, cam_dy_ = 0;
+
+    // Halfway scroll for every layer. A layer whose halfway view would leave the
+    // area the game drew in the new frame is drawn from the previous frame's
+    // map instead (copied into vram_mid_).
+    void mid_scroll(const Snap& a, const Snap& b) {
+        cam_dx_ = cam_dy_ = 0;
+        bool cam_set = false;
+        for (int bg = 0; bg < 4; ++bg) {
+            const std::size_t ox = 0x10 + bg * 4, oy = ox + 2;
+            const int ax = r16(a.io, ox) & 511, bx = r16(b.io, ox) & 511;
+            const int ay = r16(a.io, oy) & 511, by = r16(b.io, oy) & 511;
+            bool cx = false, cy = false;
+            int dx = axis_delta(ax, bx, cx), dy = axis_delta(ay, by, cy);
+            if (cx && cy && (b.dispcnt & (0x100 << bg))) { dx = cd_[bg][0]; dy = cd_[bg][1]; }
+            if (bg >= 1 && !cam_set && (b.dispcnt & (0x100 << bg)) && (cx || cy)) {
+                cam_dx_ = dx; cam_dy_ = dy; cam_set = true;
+            }
+            const int hx = half(dx), hy = half(dy);
+            int mx = bx + hx, my = by + hy;
+            margin_[bg][0] = mx;  // in the new frame's own map coordinates
+            margin_[bg][1] = my;
+            const bool use_a = (cx && (mx < 0 || mx > 7)) || (cy && (my < 0 || my > 7));
+            if (use_a) {
+                mx = ax - (dx - hx);
+                my = ay - (dy - hy);
+                const uint16_t cnt = r16(a.io, 0x08 + bg * 2);
+                const std::size_t base = static_cast<std::size_t>((cnt >> 8) & 31) * 0x800;
+                static const std::size_t sizes[4] = {0x800, 0x1000, 0x1000, 0x2000};
+                const std::size_t len = sizes[cnt >> 14];
+                if (base + len <= vram_mid_.size())
+                    std::memcpy(&vram_mid_[base], &a.vram[base], len);
+            }
+            w16(io_mid_, ox, static_cast<uint16_t>(mx & 511));
+            w16(io_mid_, oy, static_cast<uint16_t>(my & 511));
+        }
+        if (!cam_set) {  // fall back to the first enabled world layer
+            for (int bg = 1; bg < 4 && !cam_set; ++bg) {
+                if (!(b.dispcnt & (0x100 << bg))) continue;
+                bool c1, c2;
+                cam_dx_ = axis_delta(r16(a.io, 0x10 + bg * 4) & 511, r16(b.io, 0x10 + bg * 4) & 511, c1);
+                cam_dy_ = axis_delta(r16(a.io, 0x12 + bg * 4) & 511, r16(b.io, 0x12 + bg * 4) & 511, c2);
+                if (c1 && c2) { cam_dx_ = cd_[bg][0]; cam_dy_ = cd_[bg][1]; }
+                cam_set = true;
+            }
+        }
+    }
+
+    // Sprites: each sprite of the new frame is matched to the nearest sprite of
+    // the previous frame with the same shape, size and palette (the game
+    // reorders its sprite list every frame). Pieces of one character (all
+    // touching, any palette) form a group that takes the most common matched step,
+    // so a character never comes apart. The group is drawn halfway between its
+    // old and new spot: a sprite that follows the camera (the hero, the HUD)
+    // stays put, a sprite fixed in the world moves with the halfway camera, and
+    // a walking enemy moves half its step. A group with no match moves with the
+    // halfway camera. Characters' own animation still changes at the game's rate.
+    static void obj_size(uint16_t a0, uint16_t a1, int& w, int& h) {
+        static const uint8_t W[3][4] = {{8, 16, 32, 64}, {16, 32, 32, 64}, {8, 8, 16, 32}};
+        static const uint8_t H[3][4] = {{8, 16, 32, 64}, {8, 8, 16, 32}, {16, 32, 32, 64}};
+        const int sh = (a0 >> 14) & 3, sz = (a1 >> 14) & 3;
+        if (sh == 3) { w = h = 8; return; }
+        w = W[sh][sz]; h = H[sh][sz];
+        if ((a0 & 0x0300) == 0x0300) { w *= 2; h *= 2; }  // double-size affine
+    }
+
+    void mid_sprites(const Snap& a, const Snap& b) {
+        const int csx = -half(cam_dx_), csy = -half(cam_dy_);
+        struct Obj { int x, y, w, h, pal, dx, dy, grp; bool live, matched; };
+        Obj o[128];
+        bool used[128] = {};
+        for (int i = 0; i < 128; ++i) {
+            const uint16_t a0 = r16(b.oam, i * 8), a1 = r16(b.oam, i * 8 + 2), a2 = r16(b.oam, i * 8 + 4);
+            Obj& s = o[i];
+            s.live = (a0 & 0x0300) != 0x0200;
+            s.matched = false; s.grp = i; s.dx = s.dy = 0;
+            if (!s.live) continue;
+            s.x = a1 & 0x1FF; if (s.x >= 384) s.x -= 512;
+            s.y = a0 & 0xFF; if (s.y >= 224) s.y -= 256;
+            obj_size(a0, a1, s.w, s.h);
+            s.pal = (a0 & 0x2000) ? 16 : (a2 >> 12);
+            int bestd = 1 << 30, best = -1;
+            for (int j = 0; j < 128; ++j) {
+                if (used[j]) continue;
+                const uint16_t p0 = r16(a.oam, j * 8), p1 = r16(a.oam, j * 8 + 2), p2 = r16(a.oam, j * 8 + 4);
+                if ((p0 & 0x0300) == 0x0200) continue;
+                if ((p0 & 0xE300) != (a0 & 0xE300) || (p1 & 0xC000) != (a1 & 0xC000) ||
+                    (p2 & 0xF000) != (a2 & 0xF000)) continue;
+                const int dx = wrap_delta(p1 & 0x1FF, a1 & 0x1FF, 512), dy = wrap_delta(p0 & 0xFF, a0 & 0xFF, 256);
+                if (std::abs(dx) > 16 || std::abs(dy) > 16) continue;
+                int d = dx * dx + dy * dy;
+                if (std::memcmp(&a.oam[j * 8], &b.oam[i * 8], 6) == 0) d = -1;  // exact twin
+                if (d < bestd) { bestd = d; best = j; s.dx = dx; s.dy = dy; }
+            }
+            if (best >= 0) { used[best] = true; s.matched = true; }
+        }
+        // Group touching pieces with the same palette (union-find).
+        auto root = [&](int i) { while (o[i].grp != i) i = o[i].grp = o[o[i].grp].grp; return i; };
+        for (int i = 0; i < 128; ++i) {
+            if (!o[i].live) continue;
+            for (int j = i + 1; j < 128; ++j) {
+                // Any touching pieces (any palette): a hero's weapon, shadow or effect sprites use other palettes
+                // and must move with the body, or the in-between picture tears the character apart.
+                if (!o[j].live) continue;
+                if (o[i].x > o[j].x + o[j].w + 4 || o[j].x > o[i].x + o[i].w + 4 ||
+                    o[i].y > o[j].y + o[j].h + 4 || o[j].y > o[i].y + o[i].h + 4) continue;
+                const int ri = root(i), rj = root(j);
+                if (ri != rj) o[rj].grp = ri;
+            }
+        }
+        // Most common matched step per group.
+        for (int g = 0; g < 128; ++g) {
+            if (!o[g].live || root(g) != g) continue;
+            int bx = 0, by = 0, bc = 0;
+            for (int i = 0; i < 128; ++i) {
+                if (!o[i].live || !o[i].matched || root(i) != g) continue;
+                int c = 0;
+                for (int k = 0; k < 128; ++k)
+                    if (o[k].live && o[k].matched && root(k) == g && o[k].dx == o[i].dx && o[k].dy == o[i].dy) ++c;
+                if (c > bc) { bc = c; bx = o[i].dx; by = o[i].dy; }
+            }
+            const int sx = bc ? half(bx) : csx, sy = bc ? half(by) : csy;
+            if (sx == 0 && sy == 0) continue;
+            for (int i = 0; i < 128; ++i) {
+                if (!o[i].live || root(i) != g) continue;
+                const uint16_t a0 = r16(b.oam, i * 8), a1 = r16(b.oam, i * 8 + 2);
+                const int x = ((a1 & 0x1FF) + sx) & 0x1FF, y = ((a0 & 0xFF) + sy) & 0xFF;
+                w16(oam_mid_, i * 8, static_cast<uint16_t>((a0 & ~0xFF) | y));
+                w16(oam_mid_, i * 8 + 2, static_cast<uint16_t>((a1 & ~0x1FF) | x));
+            }
+        }
+    }
+};
+
+}  // namespace gbarecomp
