+// CPU speed (Return of the King engine upgrade, 2026-11-10): percent of the real
+// GBA clock the guest CPU gets. 200 = each instruction costs half its cycles, so
+// the game gets twice the work done per frame while the PPU, timers and sound
+// keep real time. Halted time (VBlankIntrWait) is never scaled. Set with
+// GBARECOMP_CPU_SPEED=<percent> or runtime_set_cpu_speed(percent); 100 = off.
+static uint32_t g_cpu_speed_pct = [] {
+    const char* e = std::getenv("GBARECOMP_CPU_SPEED");
+    long v = e ? std::strtol(e, nullptr, 10) : 100;
+    return static_cast<uint32_t>(v < 100 ? 100 : (v > 800 ? 800 : v));
+}();
+static uint32_t g_cpu_speed_frac = 0;
+extern "C" void runtime_set_cpu_speed(uint32_t pct) {
+    g_cpu_speed_pct = pct < 100 ? 100u : (pct > 800 ? 800u : pct);
+    g_cpu_speed_frac = 0;
+}
+extern "C" uint32_t runtime_get_cpu_speed(void) { return g_cpu_speed_pct; }
