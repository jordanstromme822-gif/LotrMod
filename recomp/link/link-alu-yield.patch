 // recomp and interp oracle can be aligned by identical cycle counts. (MC-HP-002.)
 extern unsigned long long g_runtime_cycles;
+// 2-player slice fast path (LotrMod, 2026-11-12). runtime_should_yield sets g_session_fast_ok when it lets an
+// instruction run inside a session slice with every slow condition already checked (slice running, not stopped,
+// stack guard fine, no unmasked IRQ pending, not suspended). Codegen calls runtime_should_yield_alu() instead of
+// runtime_should_yield() for instructions that can't change any of those (register ALU/multiply ops that don't
+// write PC or CPSR): they only need the slice deadline. Anything that ends or changes the slice clears the flag.
+extern unsigned char g_session_fast_ok;
+extern unsigned long long g_session_fast_deadline;
+static inline bool runtime_should_yield_alu(void) {
+    if (g_session_fast_ok && g_runtime_cycles < g_session_fast_deadline) return false;
+    return runtime_should_yield();
+}
 
