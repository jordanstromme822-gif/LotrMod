+#pragma once
+// 60 fps smoothing for games that draw a new picture every other VBlank.
+//
+// The game's own logic still runs at its normal rate. When a new picture
+// arrives, the host first shows an in-between picture rendered from the new
+// frame's video memory with every background scroll and every matched sprite
+// moved halfway back toward the previous picture; the next VBlank (where the
+// game would have repeated the picture) shows the new frame itself. This adds
+// one VBlank (~16.7 ms) of display delay and never touches emulated state.
+//
+// Safety: the in-between picture is only drawn when re-rendering the new
+// frame from the snapshot reproduces the real picture exactly (no mid-frame
+// raster effects), the display setup is unchanged and the camera moved a
+// small distance. Otherwise the real frame is shown untouched.
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+#include "gba_ppu.h"
+
+namespace gbarecomp {
+
+class FrameSmoother {
+public:
+    struct Snap {
+        std::vector<uint8_t> io, vram, oam, pal;
+        uint16_t dispcnt = 0;
+        bool valid = false;
+        void take(uint16_t d, const uint8_t* i, const uint8_t* v, std::size_t vn,
+                  const uint8_t* o, const uint8_t* p) {
+            io.assign(i, i + 0x400);
+            vram.assign(v, v + vn);
+            oam.assign(o, o + 0x400);
+            pal.assign(p, p + 0x400);
+            dispcnt = d;
+            valid = true;
+        }
+    };
+
+    bool enabled = true;
+    uint64_t mids = 0, skipped = 0;
+
+    // Called right after a frame is latched (emulation thread).
+    void on_latch(uint16_t dispcnt, const uint8_t* io, const uint8_t* vram,
+                  std::size_t vram_size, const uint8_t* oam, const uint8_t* pal) {
+        if (!enabled) return;
+        latest_.take(dispcnt, io, vram, vram_size, oam, pal);
+        fresh_ = true;
+    }
+
+    void reset() { prev_.valid = false; fresh_ = false; last_fb_.clear(); }
+
+    // fb holds the latched (real) frame about to be shown. May replace it with
+    // an in-between picture. Returns true if it did.
+    bool apply(const gba::GbaPpu& ppu, uint8_t* fb, std::size_t bytes) {
+        if (!enabled || !fresh_ || !latest_.valid) return false;
+        fresh_ = false;
+        if (bytes != last_bytes_) {  // view size changed
+            prev_.valid = false;
+            last_fb_.clear();
+            last_bytes_ = bytes;
+        }
+        const bool repeat = last_fb_.size() == bytes &&
+                            std::memcmp(last_fb_.data(), fb, bytes) == 0;
+        if (repeat) return false;  // shows the real (already delayed) frame
+        last_fb_.assign(fb, fb + bytes);
+        Snap& b = latest_;
+        bool did = false;
+        if (prev_.valid && compatible(prev_, b)) {
+            check_.resize(bytes);
+            ppu.render(check_.data(), b.dispcnt, b.io.data(), b.vram.data(),
+                       b.oam.data(), b.pal.data());
+            if (std::memcmp(check_.data(), fb, bytes) == 0) {
+                io_mid_ = b.io;
+                oam_mid_ = b.oam;
+                vram_mid_ = b.vram;
+                mid_scroll(prev_, b);
+                mid_sprites(prev_, b);
+                for (int bg = 0; bg < 4; ++bg) {
+                    gba::g_ws_margin_scroll_override[bg][0] = margin_[bg][0];
+                    gba::g_ws_margin_scroll_override[bg][1] = margin_[bg][1];
+                }
+                gba::g_ws_margin_scroll_override_on = 1;
+                ppu.render(fb, b.dispcnt, io_mid_.data(), vram_mid_.data(),
+                           oam_mid_.data(), b.pal.data());
+                gba::g_ws_margin_scroll_override_on = 0;
+                did = true;
+                ++mids;
+            } else {
+                ++skipped;
+            }
+        }
+        std::swap(prev_, latest_);
+        latest_.valid = false;
+        return did;
+    }
+
+private:
+    Snap latest_, prev_;
+    bool fresh_ = false;
+    std::vector<uint8_t> last_fb_, check_, io_mid_, oam_mid_, vram_mid_;
+    std::size_t last_bytes_ = 0;
+    int margin_[4][2] = {};
+
+    static uint16_t r16(const std::vector<uint8_t>& v, std::size_t o) {
+        return static_cast<uint16_t>(v[o] | (v[o + 1] << 8));
+    }
+    static void w16(std::vector<uint8_t>& v, std::size_t o, uint16_t x) {
+        v[o] = static_cast<uint8_t>(x);
+        v[o + 1] = static_cast<uint8_t>(x >> 8);
+    }
+    // Signed difference a-b on a ring of `mod` values.
+    static int wrap_delta(int a, int b, int mod) {
+        int d = (a - b) % mod;
+        if (d < -mod / 2) d += mod;
+        if (d >= mod / 2) d -= mod;
+        return d;
+    }
+
+    static bool compatible(const Snap& a, const Snap& b) {
+        if (a.dispcnt != b.dispcnt) return false;
+        if ((b.dispcnt & 7) != 0) return false;  // text-mode backgrounds only
+        // BG control, window, blend and brightness setup must be unchanged.
+        if (std::memcmp(&a.io[0x08], &b.io[0x08], 8) != 0) return false;
+        if (std::memcmp(&a.io[0x40], &b.io[0x40], 0x16) != 0) return false;
+        for (int bg = 0; bg < 4; ++bg) {
+            if (!(b.dispcnt & (0x100 << bg))) continue;
+            bool c1, c2;
+            const int dx = axis_delta(r16(a.io, 0x10 + bg * 4) & 511, r16(b.io, 0x10 + bg * 4) & 511, c1);
+            const int dy = axis_delta(r16(a.io, 0x12 + bg * 4) & 511, r16(b.io, 0x12 + bg * 4) & 511, c2);
+            if (std::abs(dx) > 24 || std::abs(dy) > 24) return false;
+        }
+        return true;
+    }
+
+    // True camera move a->b on one axis of one layer, as (scroll_a - scroll_b).
+    // This game scrolls its world layers coarsely by redrawing the whole map one
+    // tile over and keeps the fine scroll in 0..7, so there the smallest move
+    // that matches modulo 8 is the real one.
+    static int axis_delta(int sa, int sb, bool& coarse) {
+        coarse = sa < 8 && sb < 8;
+        if (!coarse) return wrap_delta(sa, sb, 512);
+        int d = sa - sb;           // -7..7
+        if (d > 4) d -= 8; else if (d < -4) d += 8;
+        return d;
+    }
+
+    int cam_dx_ = 0, cam_dy_ = 0;
+
+    // Halfway scroll for every layer. A layer whose halfway view would leave the
+    // area the game drew in the new frame is drawn from the previous frame's
+    // map instead (copied into vram_mid_).
+    void mid_scroll(const Snap& a, const Snap& b) {
+        cam_dx_ = cam_dy_ = 0;
+        bool cam_set = false;
+        for (int bg = 0; bg < 4; ++bg) {
+            const std::size_t ox = 0x10 + bg * 4, oy = ox + 2;
+            const int ax = r16(a.io, ox) & 511, bx = r16(b.io, ox) & 511;
+            const int ay = r16(a.io, oy) & 511, by = r16(b.io, oy) & 511;
+            bool cx = false, cy = false;
+            const int dx = axis_delta(ax, bx, cx), dy = axis_delta(ay, by, cy);
+            if (bg >= 1 && !cam_set && (b.dispcnt & (0x100 << bg)) && (cx || cy)) {
+                cam_dx_ = dx; cam_dy_ = dy; cam_set = true;
+            }
+            int mx = bx + dx / 2, my = by + dy / 2;
+            margin_[bg][0] = mx;  // in the new frame's own map coordinates
+            margin_[bg][1] = my;
+            const bool use_a = (cx && (mx < 0 || mx > 7)) || (cy && (my < 0 || my > 7));
+            if (use_a) {
+                mx = ax - (dx - dx / 2);
+                my = ay - (dy - dy / 2);
+                const uint16_t cnt = r16(a.io, 0x08 + bg * 2);
+                const std::size_t base = static_cast<std::size_t>((cnt >> 8) & 31) * 0x800;
+                static const std::size_t sizes[4] = {0x800, 0x1000, 0x1000, 0x2000};
+                const std::size_t len = sizes[cnt >> 14];
+                if (base + len <= vram_mid_.size())
+                    std::memcpy(&vram_mid_[base], &a.vram[base], len);
+            }
+            w16(io_mid_, ox, static_cast<uint16_t>(mx & 511));
+            w16(io_mid_, oy, static_cast<uint16_t>(my & 511));
+        }
+        if (!cam_set) {  // fall back to the first enabled world layer
+            for (int bg = 1; bg < 4 && !cam_set; ++bg) {
+                if (!(b.dispcnt & (0x100 << bg))) continue;
+                bool c1, c2;
+                cam_dx_ = axis_delta(r16(a.io, 0x10 + bg * 4) & 511, r16(b.io, 0x10 + bg * 4) & 511, c1);
+                cam_dy_ = axis_delta(r16(a.io, 0x12 + bg * 4) & 511, r16(b.io, 0x12 + bg * 4) & 511, c2);
+                cam_set = true;
+            }
+        }
+    }
+
+    // Sprites: the camera move is the main source of judder, so every sprite
+    // that belongs to the world is shifted with the halfway camera. Sprites
+    // that stayed exactly in place on screen while the camera moved (the HUD)
+    // are left alone. Characters' own steps still change at the game's rate.
+    void mid_sprites(const Snap& a, const Snap& b) {
+        const int cdx = cam_dx_, cdy = cam_dy_;
+        // Screen shift of world sprites in the in-between picture:
+        // pos_mid = pos_B + (scroll_B - scroll_mid) = pos_B - (d/2).
+        const int sx = -(cdx / 2), sy = -(cdy / 2);
+        if (sx == 0 && sy == 0) return;
+        for (int i = 0; i < 128; ++i) {
+            const uint16_t a0 = r16(b.oam, i * 8), a1 = r16(b.oam, i * 8 + 2);
+            if ((a0 & 0x0300) == 0x0200) continue;  // hidden
+            // HUD test: identical entry somewhere in the previous frame.
+            bool hud = false;
+            for (int j = 0; j < 128 && !hud; ++j)
+                hud = std::memcmp(&a.oam[j * 8], &b.oam[i * 8], 6) == 0;
+            if (hud) continue;
+            const int x = ((a1 & 0x1FF) + sx) & 0x1FF, y = ((a0 & 0xFF) + sy) & 0xFF;
+            w16(oam_mid_, i * 8, static_cast<uint16_t>((a0 & ~0xFF) | y));
+            w16(oam_mid_, i * 8 + 2, static_cast<uint16_t>((a1 & ~0x1FF) | x));
+        }
+    }
+};
+
+}  // namespace gbarecomp
